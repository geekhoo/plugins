# Shell scripts must stay LF on every platform. A CRLF shebang
# (#!/usr/bin/env bash\r) breaks with "bad interpreter" on macOS/Linux.
# The plugin ships hooks as .sh, so pin them regardless of core.autocrlf.
*.sh text eol=lf

# The MCP wire baseline is diffed byte for byte against freshly captured
# output, and wire_baseline.py writes LF. A CRLF checkout would fail that
# diff on every machine with core.autocrlf on.
geeky-orchestration/mcp/wire_baseline.json text eol=lf

# Recorded C0 evidence is hashed as captured. Do not normalize transcript bytes.
geeky-orchestration/evals/baselines/c0-wordstat/20261025T154802Z-c140d9e7/** -text
geeky-orchestration/evals/baselines/c0-wordstat/20261025T183455Z*/** -text
geeky-orchestration/evals/analyses/c0-claudex-001-preparation-20261025/** -text
geeky-orchestration/evals/analyses/c0-claudex-001-win-20261026/** -text
geeky-orchestration/evals/analyses/telemetry-identity-20261025/** -text
geeky-orchestration/evals/analyses/windows-mxc-setup-20261025/** -text
