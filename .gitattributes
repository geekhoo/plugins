# Shell scripts must stay LF on every platform. A CRLF shebang
# (#!/usr/bin/env bash\r) breaks with "bad interpreter" on macOS/Linux.
# The plugin ships hooks as .sh, so pin them regardless of core.autocrlf.
*.sh text eol=lf

# The MCP wire baseline is diffed byte for byte against freshly captured
# output, and wire_baseline.py writes LF. A CRLF checkout would fail that
# diff on every machine with core.autocrlf on.
geeky-orchestration/mcp/wire_baseline.json text eol=lf

