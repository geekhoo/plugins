+        Where-Object { $_.FullName -notmatch '[\\/]__pycache__[\\/]' } | Sort-Object FullName |
+        ForEach-Object { [ordered]@{
+            path = [IO.Path]::GetRelativePath($pluginRun, $_.FullName).Replace('\', '/')
