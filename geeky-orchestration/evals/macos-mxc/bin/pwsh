#!/bin/bash
# pwsh shim: run PowerShell as `dotnet pwsh.dll`. Under Santa Lockdown the dotnet-tool apphost (ad-hoc signed) is
# blocked while dotnet itself (Microsoft-signed) is allowed. Install once into $MXC_EVAL_ROOT/pwsh-tool:
#   dotnet tool install PowerShell --tool-path "$MXC_EVAL_ROOT/pwsh-tool"
# PWSH_DLL overrides the lookup.
ROOT=${MXC_EVAL_ROOT:-$HOME/mxc-eval}
dll=${PWSH_DLL:-$(ls "$ROOT"/pwsh-tool/.store/powershell/*/powershell/*/tools/net*/any/unix/pwsh.dll 2>/dev/null | sort -V | tail -1)}
[ -n "$dll" ] && [ -f "$dll" ] || { echo "pwsh shim: no pwsh.dll under $ROOT/pwsh-tool (set PWSH_DLL)" >&2; exit 127; }
exec /usr/local/share/dotnet/dotnet "$dll" "$@"
