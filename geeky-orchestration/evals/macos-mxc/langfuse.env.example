# langfuse.env: Langfuse keys + Claude Code telemetry for the macOS MXC eval runs.
# Copy to $MXC_EVAL_ROOT/langfuse.env, fill in the two keys, chmod 600. Never commit the filled-in file.
# The launchers source it with `set -a`; secrets therefore reach child processes through the environment,
# never through argv (endpoint agents log process arguments).
CLAUDE_CODE_ENABLE_TELEMETRY=1
CLAUDE_CODE_ENHANCED_TELEMETRY_BETA=1
LANGFUSE_BASE_URL=https://langfuse.example.com
LANGFUSE_PUBLIC_KEY="<pk-lf-...>"
LANGFUSE_SECRET_KEY="<sk-lf-...>"
LANGFUSE_TRACING_ENVIRONMENT=development
OTEL_EXPORTER_OTLP_ENDPOINT=https://langfuse.example.com/api/public/otel
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_SERVICE_NAME=claude-code
OTEL_TRACES_EXPORTER=otlp
TRACE_TO_LANGFUSE=true
# Content + delivery controls for eval runs (spans only reach Langfuse; full content comes from the transcript upload)
OTEL_LOG_USER_PROMPTS=1
OTEL_LOG_ASSISTANT_RESPONSES=1
OTEL_LOG_TOOL_DETAILS=1
OTEL_LOG_TOOL_CONTENT=1
CLAUDE_CODE_OTEL_CONTENT_MAX_LENGTH=20000
CLAUDE_CODE_OTEL_FLUSH_TIMEOUT_MS=10000
CLAUDE_CODE_OTEL_SHUTDOWN_TIMEOUT_MS=10000
CLAUDE_CODE_OTEL_DIAG_STDERR=1
# Session scores from run.json after each eval run
GEEKY_EVAL_SCORES=1
