{
  "schemaVersion": "1.0.0",
  "title": "Orders Workbench",
  "template": "basic-page",
  "themeCss": "https://cdn3.devexpress.com/jslib/25.2.3/css/dx.light.css",
  "devextremeVersion": "25.2.3",
  "containers": [
    {
      "id": "commandBar",
      "className": "orders-toolbar",
      "label": "Orders toolbar"
    },
    {
      "id": "ordersPanel",
      "className": "orders-list",
      "label": "Recent orders"
    },
    {
      "id": "overlays",
      "className": "orders-load-panel"
    }
  ],
  "widgets": [
    {
      "id": "ordersToolbar",
      "containerId": "commandBar",
      "type": "dxToolbar",
      "items": [
        {
          "location": "before",
          "text": "Orders Workbench"
        },
        {
          "location": "after",
          "widget": "dxButton",
          "options": {
            "text": "Refresh",
            "icon": "refresh",
            "type": "default",
            "onClick": {
              "kind": "named-reference",
              "name": "refreshOrders"
            }
          }
        }
      ],
      "options": {
        "elementAttr": {
          "class": "orders-toolbar-widget"
        }
      }
    },
    {
      "id": "ordersList",
      "containerId": "ordersPanel",
      "type": "dxList",
      "dataKey": "orders",
      "displayFields": ["customer", "status"],
      "options": {
        "searchEnabled": true,
        "noDataText": "No orders match the current filters.",
        "elementAttr": {
          "class": "orders-list-widget"
        },
        "onItemClick": {
          "kind": "notify",
          "message": "Order opened",
          "notifyType": "info",
          "displayTime": 1400
        }
      }
    },
    {
      "id": "loadPanel",
      "containerId": "overlays",
      "type": "dxLoadPanel",
      "options": {
        "visible": false,
        "message": "Loading orders..."
      }
    }
  ],
  "sampleData": {
    "orders": [
      {
        "id": 1001,
        "customer": "Northwind Traders",
        "status": "Ready",
        "total": 1280.5
      },
      {
        "id": 1002,
        "customer": "Contoso Retail",
        "status": "Review",
        "total": 842.0
      }
    ]
  },
  "tokens": {
    "color": {
      "surface": "#FFFFFF",
      "text": "#1F2937",
      "brand": "#1F6FEB",
      "success": "#16803C",
      "warning": "#9A6700"
    },
    "spacing": {
      "sm": "8px",
      "md": "16px",
      "lg": "24px"
    },
    "radius": {
      "sm": "4px"
    },
    "typography": {
      "fontFamily": "Arial, sans-serif"
    },
    "elevation": {
      "panel": "0 1px 3px rgba(0, 0, 0, 0.12)"
    }
  },
  "outputFiles": {
    "html": "index.html",
    "css": "styles.css",
    "js": "app.js"
  }
}
